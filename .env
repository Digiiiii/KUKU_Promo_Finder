
# =================================
# OUTPUT CONFIGURATION
# =================================

INPUT_DIR=Input
OUTPUT_DIR=out


# =================================
# LLM CONFIGURATION
# =================================
#Other providers :
#LLM_PROVIDER=deepseek
#LLM_PROVIDER=openai
#LLM_PROVIDER=anthropic
#LLM_PROVIDER=ollama
#LLM_PROVIDER=groq
#LLM_PROVIDER=mistral
#LLM_PROVIDER=openrouter

LLM_PROVIDER=google_genai
LLM_MODEL=gemini-3.5-flash-lite
GOOGLE_API_KEY=





# =================================
# PROCESSING CONFIGURATION
# =================================

WINDOW_CHARS=20000
MIN_SECONDS_BETWEEN_CALLS=2.5
MAX_CONCURRENCY=2

# =================================
# PROMO CONFIGURATION
# =================================

MIN_PROMO_DURATION=20
MAX_PROMO_DURATION=60

ENABLE_CROSS_EPISODE=true
INCLUDE_CAMERA=true

# =================================
# JUDGING CONFIGURATION
# =================================

JUDGE_BATCH=4

MIN_HOOK_SCORE=7
MIN_CLIFF_SCORE=7
MIN_STANDALONE_SCORE=6

# =================================
# LLM RELIABILITY
# =================================

LLM_RETRIES=4
RETRY_BASE_DELAY=3
